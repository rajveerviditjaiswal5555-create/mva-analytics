# ---------------------------------------------------------------------------
# Macro Vision Academy — environment configuration template
# Copy to .env and adjust. Loading into the process environment is required
# (config.py reads os.environ directly).
# ---------------------------------------------------------------------------

# SQLite by default. For PostgreSQL:
#   DATABASE_URL=postgresql+psycopg2://mva:password@localhost:5432/mva_analytics
DATABASE_URL=sqlite:///database/mva.db

# Change this to a long random value before production deployment.
SECRET_KEY=change-this-to-a-long-random-secret

# Demo-mode synthetic record count and deterministic seed.
DEMO_RECORD_TARGET=16500
DEMO_SEED=20260221

# Bearer-token session lifetime in hours.
SESSION_TTL_HOURS=12

# Comma-separated CORS origins for the frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB=25
